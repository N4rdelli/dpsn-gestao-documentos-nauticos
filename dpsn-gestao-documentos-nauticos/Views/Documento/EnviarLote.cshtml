@model IEnumerable<dpsn_gestao_documentos_nauticos.Models.Documento>

@{
    ViewData["Title"] = "Distribuição em Lote para Estaleiros";
}

<div class="mb-8">
    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Enviar Documentos Assinados</h1>
    <p class="text-sm text-slate-500 mt-1">Dispare e-mails SMTP automatizados contendo as minutas digitais assinadas em anexo diretamente para os estaleiros responsáveis.</p>
</div>

@if (TempData["MensagemErro"] != null)
{
    <div class="mb-6 p-4 bg-rose-50 border-l-4 border-rose-500 rounded-r-xl text-sm text-rose-800 font-medium shadow-sm flex items-center gap-2">
        <i class="fa-solid fa-circle-exclamation text-rose-500"></i>
        @TempData["MensagemErro"]
    </div>
}

<form asp-action="ProcessarEnviarLote" asp-controller="Documento" method="post" class="space-y-6">
    @Html.AntiForgeryToken()

    <div class="bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-slate-50/75 border-b border-slate-100 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                        <th class="px-6 py-4 w-16 text-center">Selecionar</th>
                        <th class="px-6 py-4">Estaleiro Destinatário</th>
                        <th class="px-6 py-4">Embarcação</th>
                        <th class="px-6 py-4">Arquivo Digitalizado</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-700">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-10 text-center text-slate-400 font-medium">
                                <i class="fa-solid fa-envelope-open-text text-2xl block mb-2 text-slate-300"></i>
                                Nenhuma minuta assinada pendente de disparo postal eletrônico.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4 text-center">
                                <input type="checkbox" name="documentosSelecionados" value="@item.Id" class="w-4 h-4 text-sky-600 border-slate-300 rounded focus:ring-sky-500/20 cursor-pointer" />
                            </td>
                            <td class="px-6 py-4 font-medium text-slate-900">
                                @(item.Estaleiro?.NomeFantasia ?? "Não informado")
                            </td>
                            <td class="px-6 py-4">
                                @(item.Embarcacao?.Nome ?? "Não informada")
                            </td>
                            <td class="px-6 py-4 font-mono text-xs text-slate-500">
                                <span class="inline-flex items-center gap-1">
                                    <i class="fa-solid fa-file-pdf text-rose-500"></i>
                                    @item.CaminhoPdfAssinado
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="flex items-center justify-end space-x-3">
        <a asp-action="Index" class="px-5 py-2.5 text-sm font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
            Voltar
        </a>
        @if (Model.Any())
        {
            <button type="submit" class="px-5 py-2.5 text-sm font-semibold text-white bg-sky-700 hover:bg-sky-800 rounded-lg shadow-sm hover:shadow transition-all flex items-center space-x-2">
                <i class="fa-regular fa-paper-plane text-xs"></i>
                <span>Disparar E-mails em Lote</span>
            </button>
        }
    </div>
</form>