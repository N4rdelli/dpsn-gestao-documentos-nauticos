@model dpsn_gestao_documentos_nauticos.ViewModel.DocumentoViewModel

@{
    ViewData["Title"] = "Revisar Parâmetros da Minuta";
}

<div class="mb-8">
    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Editar Documento</h1>
    <p class="text-sm text-slate-500 mt-1">Ajuste os dados operacionais ou cadastrais do armador para reemissão da minuta técnica.</p>
</div>

<form asp-action="Edit" method="post" class="space-y-6">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="EstaleiroId" />
    <input type="hidden" asp-for="EmbarcacaoId" />

    <div class="bg-white p-6 rounded-xl border border-slate-100 shadow-sm">
        <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3 mb-5">
            <i class="fa-solid fa-circle-info text-slate-400 mr-1"></i> Parâmetros Gerais do Registro
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                <label class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Número de Inscrição Oficial</label>
                <input asp-for="NumeroInscricao" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="NumeroInscricao" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
        </div>
    </div>

    <div class="bg-white p-6 rounded-xl border border-slate-100 shadow-sm">
        <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3 mb-5">
            <i class="fa-solid fa-user-anchor text-slate-400 mr-1"></i> Dados do Armador (Cliente)
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
            <div class="md:col-span-2">
                <label class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Nome do Proprietário</label>
                <input asp-for="Nome" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="Nome" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div>
                <label class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">CPF / CNPJ</label>
                <input asp-for="Cpf_cnpj" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="Cpf_cnpj" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div>
                <label class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Ano de Construção</label>
                <input asp-for="Ano_contrucao" type="number" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="Ano_contrucao" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div class="md:col-span-2">
                <label class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Identificador do Chassi</label>
                <input asp-for="NumeroChassi" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="NumeroChassi" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
        </div>
    </div>

    <div class="bg-white p-6 rounded-xl border border-slate-100 shadow-sm">
        <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3 mb-5">
            <i class="fa-solid fa-map-location-dot text-slate-400 mr-1"></i> Endereço Sede / Residencial
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
            <div>
                <label class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">CEP</label>
                <input asp-for="Cep" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="Cep" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div class="md:col-span-2">
                <label class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Logradouro</label>
                <input asp-for="Logradouro" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="Logradouro" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div>
                <label class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Número</label>
                <input asp-for="Numero" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="Numero" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div>
                <label class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Bairro</label>
                <input asp-for="Bairro" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="Bairro" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div class="md:col-span-2">
                <label class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Cidade / Município</label>
                <input asp-for="Cidade" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="Cidade" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div>
                <label class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Estado (UF)</label>
                <input asp-for="Estado" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono focus:ring-2 focus:ring-blue-500/20 uppercase" />
                <span asp-validation-for="Estado" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div class="md:col-span-4">
                <label class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Complemento</label>
                <input asp-for="Complemento" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-blue-500/20" />
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end space-x-3 pt-2">
        <a href="/Documento/Index" class="px-5 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
            Voltar
        </a>
        <button type="submit" class="px-5 py-2.5 text-sm font-semibold text-white bg-sky-700 hover:bg-sky-800 rounded-lg shadow-sm hover:shadow transition-all flex items-center space-x-2">
            <i class="fa-regular fa-pen-to-square text-xs"></i>
            <span>Atualizar Registro</span>
        </button>
    </div>
</form>