@model dpsn_gestao_documentos_nauticos.Models.Documento
@using dpsn_gestao_documentos_nauticos.Models
@using static dpsn_gestao_documentos_nauticos.Models.Documento

@{
    ViewData["Title"] = "Detalhamento de Minuta Náutica";
    var isAdminOuTecnologo = User.IsInRole("Admin") || User.IsInRole("Tecnologo");
}

<div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Detalhes do Documento</h1>
        <p class="text-sm text-slate-500 mt-1">Acompanhamento de status, auditoria de dados do armador e assinaturas digitais.</p>
    </div>
    <div class="inline-flex space-x-2">
        <a asp-action="Index" class="px-4 py-2 text-sm font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
            Voltar
        </a>
    </div>
</div>

@if (Model.Status == StatusDocumento.Assinado)
{
    <div class="bg-gradient-to-r from-emerald-500 to-teal-600 p-6 rounded-xl text-white shadow-sm mb-6 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center space-x-4">
            <div class="p-3 bg-white/10 rounded-lg backdrop-blur-md">
                <i class="fa-solid fa-file-shield text-2xl"></i>
            </div>
            <div>
                <h3 class="text-lg font-bold">Documento Concluído com Sucesso!</h3>
                <p class="text-xs text-emerald-100 mt-0.5">Assinado digitalmente por canal técnico externo homologado gov.br.</p>
            </div>
        </div>
        <a asp-action="DownloadMinuta" asp-route-id="@Model.Id" class="inline-flex items-center space-x-2 px-5 py-2.5 bg-white text-emerald-700 hover:bg-emerald-50 text-sm font-bold rounded-lg shadow transition-all">
            <i class="fa-solid fa-cloud-arrow-down"></i>
            <span>Baixar Documento Concluído</span>
        </a>
    </div>
}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <div class="lg:col-span-2 space-y-6">
        <div class="bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="bg-slate-50 px-6 py-4 border-b border-slate-100">
                <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-anchor text-slate-400"></i> Propriedades da Embarcação e Origem
                </h3>
            </div>
            <table class="w-full text-left border-collapse text-sm">
                <tbody class="divide-y divide-slate-100">
                    <tr class="hover:bg-slate-50/30">
                        <td class="px-6 py-3.5 font-medium text-slate-500 w-1/3">Estaleiro Responsável</td>
                        <td class="px-6 py-3.5 text-slate-800 font-semibold">@(Model.Estaleiro?.RazaoSocial ?? "Não vinculado")</td>
                    </tr>
                    <tr class="hover:bg-slate-50/30">
                        <td class="px-6 py-3.5 font-medium text-slate-500">Embarcação Referência</td>
                        <td class="px-6 py-3.5 text-slate-800 font-medium">@(Model.Embarcacao?.Nome ?? "Não vinculada")</td>
                    </tr>
                    <tr class="hover:bg-slate-50/30">
                        <td class="px-6 py-3.5 font-medium text-slate-500">Número de Inscrição</td>
                        <td class="px-6 py-3.5 font-mono text-slate-800 font-semibold text-xs">@Model.NumeroInscricao</td>
                    </tr>
                    <tr class="hover:bg-slate-50/30">
                        <td class="px-6 py-3.5 font-medium text-slate-500">Data de Emissão da Minuta</td>
                        <td class="px-6 py-3.5 text-slate-800">@Model.DataCriacaoDocumento.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="bg-slate-50 px-6 py-4 border-b border-slate-100">
                <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-user-tie text-slate-400"></i> Informações do Armador (Cliente)
                </h3>
            </div>
            <table class="w-full text-left border-collapse text-sm">
                <tbody class="divide-y divide-slate-100">
                    <tr class="hover:bg-slate-50/30">
                        <td class="px-6 py-3.5 font-medium text-slate-500 w-1/3">Nome Completo</td>
                        <td class="px-6 py-3.5 text-slate-800 font-semibold">@(Model.Cliente?.Nome ?? "Não cadastrado")</td>
                    </tr>
                    <tr class="hover:bg-slate-50/30">
                        <td class="px-6 py-3.5 font-medium text-slate-500">CPF / CNPJ</td>
                        <td class="px-6 py-3.5 font-mono text-slate-800">@(Model.Cliente?.Cpf_cnpj ?? "Não cadastrado")</td>
                    </tr>
                    <tr class="hover:bg-slate-50/30">
                        <td class="px-6 py-3.5 font-medium text-slate-500">Localidade Base</td>
                        <td class="px-6 py-3.5 text-slate-600 text-xs">
                            @if (Model.Cliente?.Endereco != null)
                            {
                                <span>@Model.Cliente.Endereco.Logradouro, @Model.Cliente.Endereco.Numero - @Model.Cliente.Endereco.Bairro, @Model.Cliente.Endereco.Cidade/@Model.Cliente.Endereco.Estado (CEP: @Model.Cliente.Endereco.Cep)</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="space-y-6">
        <div class="bg-white p-6 rounded-xl border border-slate-100 shadow-sm">
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Painel Operacional</h3>

            <div class="mb-5">
                <label class="text-xs text-slate-400 block mb-1">Estado Atual do Fluxo</label>
                @if (Model.Status == StatusDocumento.RevisaoPendente)
                {
                    <div class="p-3 bg-amber-50 border border-amber-200 text-amber-800 rounded-lg text-xs font-medium flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span> Aguardando Abertura Técnico
                    </div>
                }
                else if (Model.Status == StatusDocumento.EmRevisao)
                {
                    <div class="p-3 bg-blue-50 border border-blue-200 text-blue-800 rounded-lg text-xs font-medium flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span> Em Processo de Análise
                    </div>
                }
                else
                {
                    <div class="p-3 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-lg text-xs font-medium flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Finalizado e Autenticado
                    </div>
                }
            </div>

            @if (isAdminOuTecnologo)
            {
                <div class="pt-2">
                    <a asp-action="DownloadMinuta" asp-route-id="@Model.Id" class="w-full text-center block px-4 py-2.5 text-sm font-semibold text-slate-700 bg-slate-50 border border-slate-200 hover:bg-slate-100 rounded-lg shadow-sm transition-colors mb-3">
                        <i class="fa-solid fa-file-pdf text-rose-500 mr-2"></i> Baixar Documento para Assinar
                    </a>
                </div>
            }

            @if (isAdminOuTecnologo && Model.Status == StatusDocumento.EmRevisao)
            {
                <div class="mt-5 pt-5 border-t border-slate-100">
                    <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                        <i class="fa-solid fa-cloud-arrow-up text-blue-500"></i> Reenviar Documento Assinado
                    </h4>
                    <p class="text-xs text-slate-500 mb-4 leading-relaxed">
                        Após assinar externamente no painel do <strong>gov.br</strong>, faça o upload do PDF resultante abaixo para liberar o acesso ao estaleiro.
                    </p>

                    <form asp-action="AssinarEReenviar" method="post" enctype="multipart/form-data" class="space-y-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div>
                            <input type="file" name="arquivoPdf" accept=".pdf" required
                                   class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer border border-dashed border-slate-200 p-2 rounded-lg" />
                        </div>

                        <button type="submit" class="w-full py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-lg shadow transition-all flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-signature"></i> Concluir e Publicar Assinado
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>