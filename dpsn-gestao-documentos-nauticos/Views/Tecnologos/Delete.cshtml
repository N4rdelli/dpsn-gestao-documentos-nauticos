@model dpsn_gestao_documentos_nauticos.Models.Tecnologo

@{
    ViewData["Title"] = "Remover Tecnólogo";
}

<div class="mb-8">
    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Descredenciamento de Perfil Técnico</h1>
    <p class="text-sm text-slate-500 mt-1">Remoção irrevogável das permissões administrativas de monitoria no DPSN.</p>
</div>

<div class="bg-rose-50 border-l-4 border-rose-500 p-5 rounded-r-xl mb-6 shadow-sm flex items-start space-x-3">
    <i class="fa-solid fa-triangle-exclamation text-rose-500 text-lg mt-0.5"></i>
    <div>
        <h4 class="text-sm font-bold text-rose-900 uppercase tracking-wide">Atenção Extrema</h4>
        <p class="text-xs text-rose-700 mt-1 leading-relaxed">
            Ao confirmar a deleção, o usuário perderá imediatamente acesso ao painel de gerenciamento. Certifique-se de que nenhum estaleiro ativo dependa exclusivamente deste tecnólogo antes de prosseguir.
        </p>
    </div>
</div>

<div class="bg-white p-6 rounded-xl border border-slate-100 shadow-sm mb-6">
    <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3 mb-4">Confirmação dos Dados do Alvo</h3>
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-3 text-sm">
        <div>
            <dt class="text-xs font-semibold text-slate-400 uppercase">Nome Completo</dt>
            <dd class="text-slate-800 mt-0.5 font-medium">@Model.NomeCompleto</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold text-slate-400 uppercase">E-mail Institucional</dt>
            <dd class="text-slate-800 mt-0.5">@Model.Email</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold text-slate-400 uppercase">Documento de CPF</dt>
            <dd class="text-slate-800 mt-0.5 font-mono text-xs">@Model.Cpf</dd>
        </div>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post" class="flex items-center space-x-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="px-5 py-2.5 text-sm font-medium text-white bg-rose-600 hover:bg-rose-700 rounded-lg shadow-sm transition-colors flex items-center space-x-2">
        <i class="fa-regular fa-trash-can text-xs"></i>
        <span>Confirmar Remoção Permanente</span>
    </button>
    <a asp-action="Index" class="px-5 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
        Cancelar e Voltar
    </a>
</form>