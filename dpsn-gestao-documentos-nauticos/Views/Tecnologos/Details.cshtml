@model dpsn_gestao_documentos_nauticos.Models.Tecnologo

@{
    ViewData["Title"] = "Perfil do Tecnólogo";
}

<div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Dados de Monitoria e Engenharia</h1>
        <p class="text-sm text-slate-500 mt-1">Auditoria de perfil e rastreabilidade do usuário no ecossistema de documentos navais.</p>
    </div>
    <div class="inline-flex space-x-2">
        <a asp-action="Index" class="px-4 py-2 text-sm font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
            Voltar
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="px-4 py-2 text-sm font-medium text-white bg-sky-700 hover:bg-sky-800 rounded-lg shadow-sm transition-all">
            Editar Perfil
        </a>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="bg-white p-6 rounded-xl border border-slate-100 shadow-sm flex flex-col items-center justify-center text-center">
        <div class="w-20 h-20 rounded-full bg-sky-50 text-sky-700 flex items-center justify-center text-3xl font-bold border border-sky-100 mb-4">
            @Model.NomeCompleto.Substring(0, 1).ToUpper()
        </div>
        <h3 class="text-lg font-bold text-slate-900">@Model.NomeCompleto</h3>
        <p class="text-xs font-semibold px-2.5 py-1 bg-sky-50 text-sky-700 rounded-full mt-1.5 uppercase tracking-wider">Tecnólogo Credenciado</p>
        <p class="text-xs text-slate-400 mt-4 font-mono">ID: @Model.Id</p>
    </div>

    <div class="lg:col-span-2 bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="bg-slate-50 px-6 py-4 border-b border-slate-100">
            <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2">
                <i class="fa-regular fa-address-card text-slate-400"></i> Informações do Registro
            </h3>
        </div>
        <table class="w-full text-left border-collapse text-sm">
            <tbody class="divide-y divide-slate-100">
                <tr class="hover:bg-slate-50/30">
                    <td class="px-6 py-4 font-medium text-slate-500 w-1/3">E-mail Corporativo</td>
                    <td class="px-6 py-4 text-slate-800 font-medium">@Model.Email</td>
                </tr>
                <tr class="hover:bg-slate-50/30">
                    <td class="px-6 py-4 font-medium text-slate-500">Documento CPF</td>
                    <td class="px-6 py-4 font-mono text-slate-800">@Model.Cpf</td>
                </tr>
                <tr class="hover:bg-slate-50/30">
                    <td class="px-6 py-4 font-medium text-slate-500">Data de Ingresso</td>
                    <td class="px-6 py-4 text-slate-800">@Model.DataCadastro.ToLocalTime().ToString("dd 'de' MMMM 'de' yyyy, HH:mm")</td>
                </tr>
                <tr class="hover:bg-slate-50/30">
                    <td class="px-6 py-4 font-medium text-slate-500">Status da Conta</td>
                    <td class="px-6 py-4">
                        <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Ativo / Verificado
                        </span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>