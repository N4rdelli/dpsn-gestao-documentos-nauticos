@model dpsn_gestao_documentos_nauticos.Models.Tecnologo

@{
    ViewData["Title"] = "Editar Tecnólogo";
}

<div class="mb-8">
    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Modificar Dados Cadastrais</h1>
    <p class="text-sm text-slate-500 mt-1">Atualize as informações corporativas ou dados pessoais de identificação técnica do usuário.</p>
</div>

<form asp-action="Edit" method="post" class="space-y-6">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="DataCadastro" />
    <input type="hidden" asp-for="PasswordHash" />
    <input type="hidden" asp-for="SecurityStamp" />

    <div class="bg-white p-6 rounded-xl border border-slate-100 shadow-sm">
        <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3 mb-5">
            Formulário de Atualização
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                <label asp-for="NomeCompleto" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Nome Completo</label>
                <input asp-for="NomeCompleto" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="NomeCompleto" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>

            <div>
                <label asp-for="Cpf" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">CPF</label>
                <input asp-for="Cpf" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="Cpf" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>

            <div>
                <label asp-for="Email" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">E-mail</label>
                <input asp-for="Email" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="Email" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>

            <div>
                <label asp-for="UserName" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Nome de Usuário (Username)</label>
                <input asp-for="UserName" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono bg-slate-50 text-slate-400" readonly />
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end space-x-3 pt-2">
        <a asp-action="Index" class="px-5 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
            Cancelar
        </a>
        <button type="submit" class="px-6 py-2.5 text-sm font-medium text-white bg-sky-700 hover:bg-sky-800 rounded-lg shadow-sm transition-colors flex items-center space-x-2">
            <i class="fa-regular fa-circle-check text-xs"></i>
            <span>Salvar Alterações</span>
        </button>
    </div>
</form>