@model dpsn_gestao_documentos_nauticos.ViewModel.TecnologoViewModel

@{
    ViewData["Title"] = "Cadastrar Tecnólogo";
}

<div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 font-['Poppins']">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Novo Tecnólogo</h1>
        <p class="text-sm text-slate-500 mt-1">Insira as credenciais e dados cadastrais para o novo monitor do sistema.</p>
    </div>
</div>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 font-['Poppins']">
    <form asp-action="Create" method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600 bg-rose-50 p-3 rounded-lg mb-4"></div>

        <div>
            <label asp-for="NomeCompleto" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Nome Completo</label>
            <input asp-for="NomeCompleto" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 text-sm" placeholder="Ex: Hélcio de Russi" />
            <span asp-validation-for="NomeCompleto" class="text-xs text-rose-600 mt-1 block"></span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label asp-for="Email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">E-mail (Usuário)</label>
                <input asp-for="Email" type="email" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 text-sm" placeholder="exemplo@dpsn.com" />
                <span asp-validation-for="Email" class="text-xs text-rose-600 mt-1 block"></span>
            </div>
            <div>
                <label asp-for="Cpf" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">CPF</label>
                <input asp-for="Cpf" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 text-sm" placeholder="000.000.000-00" />
                <span asp-validation-for="Cpf" class="text-xs text-rose-600 mt-1 block"></span>
            </div>
        </div>

        <div>
            <label asp-for="Senha" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Senha de Acesso</label>
            <input asp-for="Senha" type="password" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 text-sm" placeholder="••••••••" />
            <span asp-validation-for="Senha" class="text-xs text-rose-600 mt-1 block"></span>
        </div>

        <div class="flex items-center justify-end space-x-3 pt-4 border-t border-slate-200">
            <a asp-action="Index" class="px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 rounded-lg transition-colors">
                Cancelar
            </a>
            <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-sky-700 hover:bg-sky-800 rounded-lg shadow-sm transition-all">
                Salvar Tecnólogo
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}