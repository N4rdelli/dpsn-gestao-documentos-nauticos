@model IEnumerable<dpsn_gestao_documentos_nauticos.ViewModel.EmbarcacaoViewModel>

@{
    ViewData["Title"] = "Gestão de Embarcações";
    var isAdminOuTecnologo = User.IsInRole("Admin") || User.IsInRole("Tecnologo");
}

<div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Embarcações</h1>
        <p class="text-sm text-slate-500">Gerencie as especificações técnicas das embarcações registradas no DPSN.</p>
    </div>
    <div>
        <a asp-action="Create" class="inline-flex items-center space-x-2 px-4 py-2.5 text-sm font-medium text-white bg-sky-700 hover:bg-sky-800 rounded-lg shadow-sm transition-all">
            <i class="fa-solid fa-plus text-xs"></i>
            <span>Nova Embarcação</span>
        </a>
    </div>
</div>

<div class="bg-white p-5 rounded-xl border border-slate-100 shadow-sm mb-6">
    <form asp-action="Index" method="get" class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
        <div class="@(isAdminOuTecnologo ? "md:col-span-6" : "md:col-span-9")">
            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1 block">Pesquisar por Termos</label>
            <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                    <i class="fa-solid fa-magnifying-glass text-sm"></i>
                </span>
                <input type="text" name="termoBusca" value="@ViewData["CurrentTermo"]" placeholder="Buscar por nome da embarcação ou estaleiro..."
                       class="w-full pl-9 pr-4 py-2 text-sm rounded-lg border border-slate-200 text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500" />
            </div>
        </div>

        @if (isAdminOuTecnologo)
        {
            <div class="md:col-span-4">
                <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1 block">Filtrar por Estaleiro</label>
                <select name="estaleiroId" asp-items="ViewBag.EstaleirosFiltro"
                        class="w-full px-3 py-2 text-sm rounded-lg border border-slate-200 text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500">
                    <option value="">-- Todos os Estaleiros --</option>
                </select>
            </div>
        }

        <div class="md:col-span-2 flex space-x-2 w-full">
            <button type="submit" class="flex-1 justify-center inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-slate-800 hover:bg-slate-900 rounded-lg transition-colors">
                Filtrar
            </button>
            <a asp-action="Index" class="inline-flex items-center px-3 py-2 text-sm font-medium text-slate-500 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors" title="Limpar Filtros">
                <i class="fa-solid fa-rotate-left"></i>
            </a>
        </div>
    </form>
</div>

<div class="bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-100 text-xs font-semibold text-slate-600 uppercase tracking-wider">
                    <th class="px-6 py-4">Embarcação</th>
                    <th class="px-6 py-4">Tipo / Material</th>
                    <th class="px-6 py-4">Estaleiro Responsável</th>
                    <th class="px-6 py-4">Comprimento Total</th>
                    <th class="px-6 py-4 text-right">Ações</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-sm text-slate-700">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-slate-400">
                            <div class="flex flex-col items-center justify-center space-y-2">
                                <i class="fa-solid fa-anchor text-2xl text-slate-300"></i>
                                <span>Nenhuma embarcação foi encontrada com os filtros aplicados.</span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4 font-semibold text-slate-900">
                                @item.Nome
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex flex-col">
                                    <span class="text-slate-800 font-medium">@item.TipoEmbarcacao</span>
                                    <span class="text-xs text-slate-400">Casco: @item.MaterialCasco</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-slate-600">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
                                    @item.NomeEstaleiro
                                </span>
                            </td>
                            <td class="px-6 py-4 font-mono text-slate-600">
                                @item.ComprimentoTotal.ToString("N2") metros
                            </td>
                            <td class="px-6 py-4 text-right whitespace-nowrap">
                                <div class="inline-flex items-center space-x-1.5">
                                    <a asp-action="Details" asp-route-id="@item.IdEmbarcacao" class="p-1.5 text-slate-400 hover:text-slate-600 bg-slate-50 hover:bg-slate-100 rounded-md transition-colors" title="Especificações Técnicas">
                                        <i class="fa-regular fa-eye text-sm"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.IdEmbarcacao" class="p-1.5 text-blue-500 hover:text-blue-700 bg-blue-50 hover:bg-blue-100 rounded-md transition-colors" title="Editar">
                                        <i class="fa-regular fa-pen-to-square text-sm"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.IdEmbarcacao" class="p-1.5 text-rose-500 hover:text-rose-700 bg-rose-50 hover:bg-rose-100 rounded-md transition-colors" title="Excluir">
                                        <i class="fa-regular fa-trash-can text-sm"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>