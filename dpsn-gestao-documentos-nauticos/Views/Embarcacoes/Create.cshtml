@model dpsn_gestao_documentos_nauticos.ViewModel.EmbarcacaoViewModel

@{
    ViewData["Title"] = "Nova Embarcação";
    var isAdminOuTecnologo = User.IsInRole("Admin") || User.IsInRole("Tecnologo");
}

<div class="mb-8">
    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Cadastrar Embarcação</h1>
    <p class="text-sm text-slate-500 mt-1">Preencha os parâmetros de engenharia e dimensões estruturais para emissão de relatórios.</p>
</div>
<div class="card-header bg-light">
    <strong>Importar dados via PDF</strong>
</div>


<form asp-action="importPdf" asp-controller="Embarcacoes" method="post" enctype="multipart/form-data" class="form-inline">
    <div class="form-group mb-2">
        <label for="arquivoPdf" class="mr-2">Selecione o documento da Marinha (.pdf):</label>
        <input type="file" name="arquivo" id="arquivoPdf" class="form-control-file" accept=".pdf" required />
    </div>
    <button type="submit" class="btn btn-primary mb-2">Extrair Dados</button>
</form>
<form asp-action="Create" asp-controller="Embarcacoes" method="post" class="space-y-6">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-xs text-red-500 list-disc pl-5"></div>

    <div class="bg-white p-6 rounded-xl border border-slate-100 shadow-sm">
        <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3 mb-5">Seção 1: Identificação e Propriedade</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            <div class="md:col-span-1">
                <label asp-for="Nome" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Nome da Embarcação</label>
                <input asp-for="Nome" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500" />
                <span asp-validation-for="Nome" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div>
                <label asp-for="TipoEmbarcacao" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Tipo de Embarcação</label>
                <input asp-for="TipoEmbarcacao" placeholder="Ex: Carga, Lazer, Pesquisa" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500" />
                <span asp-validation-for="TipoEmbarcacao" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div>
                <label asp-for="MaterialCasco" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Material do Casco</label>
                <input asp-for="MaterialCasco" placeholder="Ex: Aço, Alumínio, Fibra" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500" />
                <span asp-validation-for="MaterialCasco" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>

            <div class="md:col-span-3">
                <label asp-for="EstaleiroId" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Estaleiro Responsável pela Construção</label>
                @if (isAdminOuTecnologo)
                {
                    <select asp-for="EstaleiroId" asp-items="Model.EstaleirosDisponiveis" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500">
                        <option value="">-- Selecione o Estaleiro Construtor --</option>
                    </select>
                }
                else
                {
                    <select asp-for="EstaleiroId" asp-items="Model.EstaleirosDisponiveis" readonly class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm bg-slate-50 text-slate-500 pointer-events-none"></select>
                    <p class="text-[11px] text-slate-400 mt-1">Vinculado automaticamente ao seu perfil de estaleiro corporativo.</p>
                }
                <span asp-validation-for="EstaleiroId" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
        </div>
    </div>

    <div class="bg-white p-6 rounded-xl border border-slate-100 shadow-sm">
        <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3 mb-5">Seção 2: Dimensões Principais (Metros)</h3>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-5">
            <div>
                <label asp-for="ComprimentoTotal" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Comprimento Total</label>
                <input asp-for="ComprimentoTotal" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="ComprimentoTotal" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div>
                <label asp-for="BocaMoldada" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Boca Moldada</label>
                <input asp-for="BocaMoldada" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="BocaMoldada" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div>
                <label asp-for="PontalMoldado" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Pontal Moldado</label>
                <input asp-for="PontalMoldado" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="PontalMoldado" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div class="col-span-2 md:col-span-1">
                <label asp-for="Contorno" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Contorno</label>
                <input asp-for="Contorno" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="Contorno" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
        </div>
    </div>

    <div class="bg-white p-6 rounded-xl border border-slate-100 shadow-sm">
        <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3 mb-5">Seção 3: Calados, Volumetria e Arqueações</h3>
        <div class="grid grid-cols-2 md:grid-cols-6 gap-5">
            <div>
                <label asp-for="CaladoMaximo" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Calado Máximo</label>
                <input asp-for="CaladoMaximo" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono" />
                <span asp-validation-for="CaladoMaximo" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div>
                <label asp-for="CaladoLeve" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Calado Leve</label>
                <input asp-for="CaladoLeve" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono" />
                <span asp-validation-for="CaladoLeve" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div>
                <label asp-for="ArqueacaoBruta" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Arqueação Bruta (AB)</label>
                <input asp-for="ArqueacaoBruta" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono" />
                <span asp-validation-for="ArqueacaoBruta" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div>
                <label asp-for="ArqueacaoLiquida" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Arqueação Líq. (AL)</label>
                <input asp-for="ArqueacaoLiquida" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono" />
                <span asp-validation-for="ArqueacaoLiquida" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div>
                <label asp-for="Tpb" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">TPB (Toneladas)</label>
                <input asp-for="Tpb" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono" />
                <span asp-validation-for="Tpb" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div>
                <label asp-for="Lastro" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Lastro (Opcional)</label>
                <input asp-for="Lastro" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono" />
            </div>
        </div>
    </div>

    <div class="bg-white p-6 rounded-xl border border-slate-100 shadow-sm">
        <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3 mb-5">Seção 4: Propulsão, Operação e Serviço</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            <div class="md:col-span-1">
                <label asp-for="AreaNavegacaoTipoServico" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Área de Navegação / Tipo Serviço</label>
                <input asp-for="AreaNavegacaoTipoServico" placeholder="Ex: Mar Aberto / Apoio Portuário" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="AreaNavegacaoTipoServico" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div>
                <label asp-for="MotorizacaoMax" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Motorização Máxima</label>
                <input asp-for="MotorizacaoMax" type="number" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono" />
                <span asp-validation-for="MotorizacaoMax" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div>
                <label asp-for="MotorizacaoMin" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">Motorização Minima</label>
                <input asp-for="MotorizacaoMin" type="number" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono" />
                <span asp-validation-for="MotorizacaoMin" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
        </div>
    </div>
    <div class="bg-white p-6 rounded-xl border border-slate-100 shadow-sm">
        <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3 mb-5">Seção 5: Tripulação e Passageiros</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            <div class="md:col-span-1">
                <label asp-for="Tripulantes" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">N° de Tripulantes</label>
                <input asp-for="Tripulantes" placeholder="Quantidade de tripulantes da embarcação" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="Tripulantes" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
            <div>
                <label asp-for="Passageiros" class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1 block">N° de Passageiros</label>
                <input asp-for="Passageiros" type="number" placeholder="Quantidade de passageiros da embarcação" class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm font-mono" />
                <span asp-validation-for="Passageiros" class="text-xs text-red-500 mt-1 block font-medium"></span>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end space-x-3 pt-2">
        <a asp-action="Index" class="px-5 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
            Cancelar
        </a>
        <button type="submit" class="px-5 py-2.5 text-sm font-medium text-white bg-sky-700 hover:bg-sky-800 rounded-lg shadow-sm transition-all">
            Salvar Registro
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}